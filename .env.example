# Local environment variables (copy of .env.example). Edit before use.
SECRET_KEY=change-me
JWT_SECRET_KEY=${SECRET_KEY}
DATABASE_URL=postgresql://meal_user:meal_password@localhost:5432/meal_db
DEFAULT_USER_USERNAME=admin
DEFAULT_USER_PASSWORD=changeme
DEFAULT_USER_EMAIL=admin@example.com

#AUTO_CREATE_TABLES=true
# Example environment variables for development and local deployment
# Copy this file to .env and fill values with secure secrets before running.


# Database (PostgreSQL)
# When using docker-compose the host can be the service name (e.g. db)
POSTGRES_USER=meal_user
POSTGRES_PASSWORD=meal_password
POSTGRES_DB=meal_db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# JWT / Auth
JWT_SECRET_KEY=replace-with-a-different-secure-string
JWT_ACCESS_EXPIRES_DAYS=365

